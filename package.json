{
  "name": "spotify-dl",
  "version": "1.0.0",
  "description": "A warm, modern desktop app for downloading Spotify tracks, albums and playlists",
  "main": "./out/main/index.js",
  "author": "Soroush Eghdami",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "backend:build": "powershell -NoProfile -ExecutionPolicy Bypass -File backend/build.ps1",
    "dist": "npm run backend:build && npm run build && electron-builder --win",
    "dist:app": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "lucide-react": "^0.545.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "~7.3.6"
  }
}
